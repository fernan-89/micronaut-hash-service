  },
  "item": [
    {
      "name": "00. Infrastructure & Telemetry",
      "item": [
        {
          "name": "Health Check (Kubernetes Probes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK or UP\", () => {",
                  "    pm.expect(pm.response.hasProperty('code') ? pm.response.code : pm.response.status).to.be.oneOf([200, 503]);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Health payload contains status\", () => pm.expect(jsonData).to.have.property('status'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. Generate Hash (SHA3_256)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
              "const jsonData = pm.response.json();",
              "pm.environment.set(\"hashId\", jsonData.id);",
              "pm.test(\"Hash ID was generated\", () => pm.expect(jsonData.id).to.not.be.undefined);",
              "pm.test(\"Algorithm matches SHA3_256\", () => pm.expect(jsonData.algorithm).to.eql(\"SHA3_256\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tenantId\": \"tenant-123\",\n    \"payload\": \"dado-de-teste-sha3-{{$randomAlphaNumeric}}\",\n    \"algorithm\": \"SHA3_256\",\n    \"sourceService\": \"mobile-app\",\n    \"executor\": \"test-user-01\",\n    \"asSerialKey\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/hashes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "01b. Generate Hash (SHA_256 Variant)",
      "event": [

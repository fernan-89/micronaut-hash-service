              "const jsonData = pm.response.json();",
              "pm.environment.set(\"sha256Id\", jsonData.id);",
              "pm.test(\"Algorithm matches SHA_256\", () => pm.expect(jsonData.algorithm).to.eql(\"SHA_256\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tenantId\": \"tenant-123\",\n    \"payload\": \"dado-de-teste-sha256-{{$randomAlphaNumeric}}\",\n    \"algorithm\": \"SHA_256\",\n    \"sourceService\": \"backend-service\",\n    \"executor\": \"test-user-02\",\n    \"asSerialKey\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/hashes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes"

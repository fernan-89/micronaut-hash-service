    {
      "name": "01c. Generate Hash (BLAKE3 Variant)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
              "const jsonData = pm.response.json();",
              "pm.environment.set(\"blake3Id\", jsonData.id);",
              "pm.test(\"Algorithm matches BLAKE3\", () => pm.expect(jsonData.algorithm).to.eql(\"BLAKE3\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tenantId\": \"tenant-123\",\n    \"payload\": \"dado-de-teste-blake3-{{$randomAlphaNumeric}}\",\n    \"algorithm\": \"BLAKE3\",\n    \"sourceService\": \"security-scanner\",\n    \"executor\": \"crypto-admin\",\n    \"asSerialKey\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/hashes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Get Hash By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"ID matches environment\", () => pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"hashId\")));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/hashes/{{hashId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes",
            "{{hashId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. List Tenant Hashes (Paginated & Filtered)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns list or array structure\", () => {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-Id",
            "value": "tenant-123"
          }
        ],
        "url": {
          "raw": "{{base_url}}/hashes?page=0&size=20&status=ACTIVE",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            },
            {
              "key": "status",
              "value": "ACTIVE"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "04. Deactivate Hash",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status updated to INACTIVE\", () => {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"INACTIVE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"executor\": \"admin-user\",\n    \"reason\": \"Manutenção programada e suspensão temporária\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/hashes/{{hashId}}/deactivate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes",
            "{{hashId}}",
            "deactivate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05. Reactivate Hash",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status restored to ACTIVE\", () => {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ACTIVE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"executor\": \"admin-user\",\n    \"reason\": \"Retorno à operação regulamentar\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/hashes/{{hashId}}/reactivate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes",
            "{{hashId}}",
            "reactivate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06. Get Forensic Audit Trail",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "const logs = pm.response.json();",
              "pm.test(\"Is a non-empty list\", () => pm.expect(logs).to.be.an('array').and.not.empty);",
              "pm.test(\"Contains entityId mapping\", () => pm.expect(logs[0].entityId).to.eql(pm.environment.get(\"hashId\")));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/hashes/{{hashId}}/audit",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hashes",
            "{{hashId}}",
            "audit"
          ]
        }
      },
      "response": []
    },
    {
      "name": "07. Revoke Hash (Terminal State)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status is REVOKED\", () => {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"REVOKED\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
